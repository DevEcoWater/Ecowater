# Compose project name. The compose file defaults to "ecowater" when CLIENT_SLUG
# is unset; set the slug here to scope containers, volumes and networks per
# client. Leaving both unset used to make compose name the project after its own
# directory, which then refused to touch the containers already running.
CLIENT_SLUG=ecowater

# App
NODE_ENV=production
APP_BASE_URL=https://ecowater.example.com
NEXT_PUBLIC_NAME=EcoWater
PORT=3000

# Auth
AUTH_SECRET=replace_with_strong_random_secret
# Optional fallback supported by auth code:
NEXTAUTH_SECRET=replace_with_strong_random_secret

# Cron endpoint protection
CRON_SECRET=replace_with_strong_random_secret
SKIP_DB_MIGRATIONS=false

# PostgreSQL container credentials
POSTGRES_DB=ecowater
POSTGRES_USER=ecowater
POSTGRES_PASSWORD=replace_with_strong_password

# Prisma connection strings (inside Docker network)
DATABASE_URL=postgresql://ecowater:replace_with_strong_password@postgres:5432/ecowater?schema=public
DIRECT_URL=postgresql://ecowater:replace_with_strong_password@postgres:5432/ecowater?schema=public

# Consola web de solo lectura (pgweb). Apunta al rol readonly, NO al de la app.
# Si la contrasena tiene caracteres raros hay que escaparlos para la URL.
PGWEB_DATABASE_URL=postgresql://readonly:replace_with_readonly_password@postgres:5432/ecowater?sslmode=disable

# CRM integration
CRM_URL=https://crm.example.com
CRM_API_KEY=replace_with_crm_api_key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# MQTT — valve control (ED-88)
# Use mqtt://mqtt:1883 for the broker in this compose stack, or mqtts://host:8883
# for an external one. The scheme matters: mqtt:// on port 8883 will not connect.
MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Feature flags. These override config/client.config.ts when set.
# Without FEATURE_VALVE_CONTROL=true the valve card never renders.
FEATURE_VALVE_CONTROL=false
FEATURE_ADVANCED_EXPORT=false
FEATURE_URGENCIES=false
