// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CooperativeStatus {
  ACTIVE
  INACTIVE
}

model Cooperative {
  id             String            @id @default(uuid())
  name           String
  location       String?
  contact_person String?
  phone_number   String?
  status         CooperativeStatus @default(ACTIVE)
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

model User {
  id         String     @id @default(uuid())
  username   String
  email      String     @unique
  password   String
  address    String?
  status     UserStatus @default(ACTIVE)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  userRoles  UserRole[]
  userMeters UserMeter[]

  @@index([email])
}

model Role {
  id        String     @id @default(uuid())
  role_name String     @unique // admin, supervisor, neighbor
  userRoles UserRole[]
}

model UserRole {
  user_id    String
  role_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
}

model UserMeter {
  id          String   @id @default(uuid())
  user_id     String
  meter_id    String
  assigned_at DateTime @default(now())

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meter Meter @relation(fields: [meter_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([meter_id])
}

enum MeterStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  FAULTY
}

enum OperationalStatus {
  OPERATIONAL
  ERROR
  NEEDS_MAINTENANCE
}

model Meter {
  id                 String            @id @default(uuid())
  dev_eui            String            @unique
  device_name        String
  application_id     String?
  application_name   String?
  lat                Float?
  lng                Float?
  status             MeterStatus       @default(ACTIVE)
  operational_status OperationalStatus @default(OPERATIONAL)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  userMeters UserMeter[]
  readings   Reading[]

  @@index([dev_eui])
}

enum ReadingStatus {
  VALID
  INVALID
  UNDER_REVIEW
  ARCHIVED
}

model Reading {
  id                    String        @id @default(uuid())
  meter_id              String
  timestamp             DateTime      @default(now())
  fCnt                  Int?
  fPort                 Int?
  adr                   Boolean       @default(false)
  status                ReadingStatus @default(VALID)
  cumulative_flow       String?
  cumulative_daily_flow String?
  reverse_flow          String?
  instantaneous_flow    String?
  real_time_temperature String?
  alarm_status          String?
  error_code            String?
  spare                 String?
  check_code            String?
  ending_code           String?

  meter    Meter    @relation(fields: [meter_id], references: [id], onDelete: Cascade)
  statuses Status[]
  rxInfos  RxInfo[]

  @@index([meter_id])
  @@index([timestamp])
}

model Status {
  id              String   @id @default(uuid())
  reading_id      String
  status_type_id  String
  status_value_id String
  created_at      DateTime @default(now())

  reading      Reading     @relation(fields: [reading_id], references: [id], onDelete: Cascade)
  status_type  StatusType  @relation(fields: [status_type_id], references: [id], onDelete: Cascade)
  status_value StatusValue @relation(fields: [status_value_id], references: [id], onDelete: Cascade)

  @@index([reading_id])
  @@index([status_type_id])
  @@index([status_value_id])
}

model StatusType {
  id          String        @id @default(uuid())
  name        String        @unique // valve_status, battery_status, etc.
  description String?
  statuses    Status[]
  values      StatusValue[]
}

model StatusValue {
  id             String     @id @default(uuid())
  status_type_id String
  value          String
  description    String?
  statusType     StatusType @relation(fields: [status_type_id], references: [id], onDelete: Cascade)
  statuses       Status[]

  @@unique([status_type_id, value])
  @@index([status_type_id])
}

enum RxInfoStatus {
  RECEIVED
  FAILED
  DELAYED
  ARCHIVED
}

model RxInfo {
  id           String       @id @default(uuid())
  reading_id   String
  gateway_id   String
  lora_snr     Float?
  rssi         Int?
  latitude     Float?
  longitude    Float?
  altitude     Float?
  time         DateTime     @default(now())
  status       RxInfoStatus @default(RECEIVED)
  error_detail String?

  reading Reading @relation(fields: [reading_id], references: [id], onDelete: Cascade)
  gateway Gateway @relation(fields: [gateway_id], references: [id], onDelete: Cascade)

  @@index([reading_id])
  @@index([gateway_id])
  @@index([time])
}

model Gateway {
  id           String   @id @default(uuid())
  gateway_code String   @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  rxInfos RxInfo[]
}
